# Somente ambiente de teste E2E (Playwright, glosas-ai/e2e). Sem segredos.
# Carregado com APP_ENV=e2e / --env=e2e. Nada aqui é usado em dev ou produção.
# Os valores críticos (DB_DATABASE, LARAVEL_STORAGE_PATH) são forçados pelo runner em
# glosas-ai/e2e/support/env.ts; os daqui são só o que não depende da máquina.
# tests/Unit/EnvE2eFileTest.php falha se este arquivo ganhar segredo ou banco não-sqlite.

APP_NAME=GlosasAI-E2E
APP_ENV=e2e
# Chave exclusiva deste ambiente de teste, não reutilizada em lugar nenhum.
APP_KEY=base64:RKOTFZu0/h6U09wUpzI0Z9sPs6gPEoC06J+q91iQdwA=
APP_DEBUG=true
APP_URL=http://localhost:8021
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR

BCRYPT_ROUNDS=4

LOG_CHANNEL=single
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# Inválido de propósito: o runner sobrescreve com o caminho absoluto de database/e2e.sqlite.
DB_DATABASE=/nonexistent/forced-by-e2e-runner.sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
# Nome próprio: cookie não isola por porta, e o app de dev também roda em localhost.
SESSION_COOKIE=glosas_e2e_session

CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log

FRONTEND_URL=http://localhost:5193
SANCTUM_STATEFUL_DOMAINS=localhost:5193
